# ZAYVORA MATAB OS — Environment Configuration Template
# COPY TO .env FOR LOCAL DEVELOPMENT. DO NOT COMMIT REAL PRODUCTION SECRETS.

# Application Environment: development | test | production
MATAB_ENV=development

# Application Profile: MATAB (Solo) | CLINIC (Multi-doc) | HOSPITAL (Enterprise)
MATAB_PROFILE=MATAB

# Server Binding
MATAB_HOST=127.0.0.1
MATAB_PORT=8000

# Database Configuration (PostgreSQL URL for Docker / SQLite path for Edge)
DATABASE_URL=sqlite:///matab.db
# For PostgreSQL: postgresql://matab_user:matab_pass@localhost:5432/matab_os

# Security & Sessions (Must be set to strong cryptographically random 64-char key in production)
MATAB_SECRET_KEY=change-this-insecure-dev-key-before-production-use-2026

# Session Lifetime (Hours)
MATAB_SESSION_HOURS=12

# Rate Limiting (Requests per minute on auth endpoints)
MATAB_AUTH_RATE_LIMIT=10

# Fail-Closed Safety Preflight Policy (true = halt on safety UNKNOWN)
MATAB_FAIL_CLOSED=true

# Allowed CORS Origins (Comma-separated)
MATAB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
